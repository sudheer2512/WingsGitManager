{
  "GitManager": {
    "WorkspaceRoots": [ "../../App_Data/workspaces" ],
    "DataDirectory": "../../App_Data/git-manager",
    "AllowHttpRemotes": true
  },
  "ConnectionStrings": { "GitManager": "Data Source=../../App_Data/git-manager.db" },
  "Gitea": {
    "BaseUrl": "http://localhost:3380",
    "ServiceUser": "wings-admin",
    "OrganizationPrefix": "wings-"
  },
  "Backup": { "FileSystemRoot": "../../App_Data/backups" },
  "Cors": { "Origins": [ "http://localhost:4380" ] },
  "Serilog": {
    "WriteTo": [ { "Name": "File", "Args": { "path": "../../App_Data/logs/git-manager-.log", "rollingInterval": "Day" } } ]
  }
}
