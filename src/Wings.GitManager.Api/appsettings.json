{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "App_Data/logs/git-manager-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30, "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*",
  "Database": { "Provider": "Sqlite", "AutoCreate": true },
  "ConnectionStrings": { "GitManager": "Data Source=App_Data/git-manager.db" },
  "GitManager": {
    "WorkspaceRoots": [ "App_Data/workspaces" ],
    "EnforceCompanyDirectories": true,
    "DataDirectory": "App_Data/git-manager",
    "DefaultProvider": "Gitea",
    "AllowHttpRemotes": false,
    "AllowFileRemotes": false
  },
  "Gitea": {
    "BaseUrl": "",
    "ServiceUser": "wings-git-manager",
    "OrganizationPrefix": "",
    "AutoCreateOrganizations": true
  },
  "Backup": {
    "Provider": "filesystem",
    "FileSystemRoot": "App_Data/backups",
    "RequireEncryption": true
  },
  "Worker": { "RunInApi": true },
  "Authentication": { "Oidc": { "Authority": "", "Audience": "wings-git-manager" } }
}
