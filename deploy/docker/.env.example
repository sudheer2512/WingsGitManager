# Copy to .env (never commit the real file). Generate secrets with: openssl rand -base64 32
PUBLIC_HOST=git-manager.example.com
GITEA_HOST=git.example.com
SQL_SA_PASSWORD=change-me-Strong-Passw0rd!
# Gitea service account + token used by Wings Git Manager (create after first Gitea start; see docs/operations.md)
GITEA_SERVICE_USER=wings-git-manager
GITEA_TOKEN=
GITEA_WEBHOOK_SECRET=
# 256-bit base64 key; store a copy OUTSIDE this server (password manager / KMS). Without it backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Optional S3-compatible backup destination (recommended: separate account/region, versioning + object lock)
BACKUP_PROVIDER=filesystem
S3_SERVICE_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# OIDC authority for interactive users (e.g. the Wings Authentication server); empty = API tokens only
OIDC_AUTHORITY=
