# /etc/systemd/system/wings-git-manager-worker.service  (Linux + Nginx deployment)
[Unit]
Description=Wings Git Manager Worker
After=network-online.target
Wants=network-online.target

[Service]
User=wings
Group=wings
WorkingDirectory=/opt/wings-git-manager/worker
ExecStart=/usr/bin/dotnet /opt/wings-git-manager/worker/Wings.GitManager.Worker.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=Worker__InstanceName=%H
# Secrets (Gitea token, backup key, connection string) live in a root-readable env file:
EnvironmentFile=/etc/wings-git-manager/secrets.env
Restart=always
RestartSec=5
# Restricted OS privileges for Git operations.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wings /var/log/wings
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
